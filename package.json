{
  "name": "stock-dashboard",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:server\"",
    "dev:frontend": "vite",
    "dev:server": "node server/index.js",
    "build:data": "node scripts/build-data.js",
    "build": "vite build",
    "build:site": "node scripts/build-data.js && vite build",
    "preview": "vite preview",
    "server": "node server/index.js",
    "refresh": "node server/scripts/refresh.js"
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "concurrently": "^8.2.2",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "node-fetch": "^3.3.2",
    "puppeteer": "^22.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.13.0",
    "recharts": "^2.10.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.2.0",
    "vite": "^5.0.0"
  }
}
